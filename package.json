{
  "name": "dsh-destinywind-rag",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "description": "知识库 / RAG：本地优先的混合检索（BM25 + 向量 + RRF 融合），双向量引擎（OpenAI 兼容 / 自定义 HTTP 大模型端点，本地 ONNX / Ollama），零配置开箱可用；设置页「知识库」栏管理，输入框旁选择检索范围。",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/zh.json",
    "locale/en.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "test": "node --test tests/"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
